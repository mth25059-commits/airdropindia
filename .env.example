# =============================================================================
# AirdropIndia + CryptoTaxIndia — environment variables
# Copy this file to `.env.local` and fill in the values.
# =============================================================================

# ---- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="AirdropIndia"

# ---- Supabase (DB + Auth + Storage) -----------------------------------------
# Create a project at https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Groq AI (Llama 3.1 70B) -----------------------------------------------
# https://console.groq.com → API Keys
GROQ_API_KEY=""

# ---- Resend (transactional + marketing email) -------------------------------
# https://resend.com → API Keys
RESEND_API_KEY=""
# Use `onboarding@resend.dev` for testing, or a verified domain like
# `alerts@airdropindia.in` once you've added the domain to Resend.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ---- Admin / Cron -----------------------------------------------------------
# Comma-separated list of emails that can access /admin
ADMIN_EMAILS=""
# Random string to protect /api/cron endpoints. Generate with:
#   openssl rand -hex 32
CRON_SECRET=""

# ---- Google OAuth -----------------------------------------------------------
# These are configured INSIDE the Supabase dashboard:
#   Authentication → Providers → Google → enable
# You do NOT need to add Google client_id/secret here — Supabase handles it.
